{
  "name": "@vamsitalupula/pi-debug",
  "repository": "github:tanavamsikrishna/pi-debug",
  "version": "2.0.2",
  "description": "Run Typescript within the Node.js context of the Pi coding agent",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --outDir extensions --publicDir ./static/ --external @earendil-works/pi-coding-agent",
    "dev": "tsup src/index.ts --format esm --watch --outDir extensions --publicDir ./static/ --external @earendil-works/pi-coding-agent",
    "test": "node --experimental-strip-types --test test/pi-debug.test.ts"
  },
  "files": [
    "extensions",
    "package.json"
  ],
  "main": "extensions/index.js",
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "typescript",
    "jiti",
    "devtool",
    "runner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "access": "public",
  "pi": {
    "extensions": [
      "extensions/"
    ],
    "image": "https://raw.githubusercontent.com/tanavamsikrishna/pi-debug/refs/heads/main/screenshot.png"
  }
}
